{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed results.json state_contracts extension (not whole results.json)",
  "$comment": "State extension: v1 retains historical unavailable forces; v2 adds validated NC forces. Reject duplicate keys and nonfinite values before validation. Numbers under unavailable are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_status",
    "extension_version",
    "model_digest",
    "basis_digest",
    "state_digest",
    "spin",
    "occupations",
    "thermodynamics",
    "forces",
    "stress"
  ],
  "properties": {
    "proposal_status": {
      "const": "proposed"
    },
    "extension_version": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "basis_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spin": {
      "$ref": "spin.proposal.json"
    },
    "occupations": {
      "$ref": "occupations.proposal.json"
    },
    "thermodynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_energy_ha",
        "free_energy_ha",
        "entropy_term_ha",
        "entropy_over_kb",
        "entropy_kind",
        "temperature_energy_ha",
        "variational_quantity",
        "grand_potential"
      ],
      "properties": {
        "internal_energy_ha": {
          "type": "number"
        },
        "free_energy_ha": {
          "type": "number"
        },
        "entropy_term_ha": {
          "type": "number",
          "minimum": 0
        },
        "entropy_over_kb": {
          "type": "number",
          "minimum": 0
        },
        "entropy_kind": {
          "enum": [
            "zero",
            "physical_fermi_dirac"
          ]
        },
        "temperature_energy_ha": {
          "type": "number",
          "minimum": 0
        },
        "variational_quantity": {
          "enum": [
            "internal_energy",
            "free_energy"
          ]
        },
        "grand_potential": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "const": "fixed_electron_number"
            }
          }
        }
      }
    },
    "forces": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "units",
            "frame"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_implemented",
                "not_requested",
                "not_converged",
                "standard_profile",
                "incomplete_derivative_coverage",
                "model_mismatch"
              ]
            },
            "units": {
              "const": "Ha/Bohr"
            },
            "frame": {
              "const": "cartesian_input_atom_order"
            },
            "unavailable_terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "reason": {
                    "const": "incomplete_derivative_coverage"
                  }
                }
              },
              "then": {
                "required": [
                  "unavailable_terms"
                ],
                "properties": {
                  "unavailable_terms": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        {
          "$ref": "forces-available.proposal.json"
        }
      ]
    },
    "stress": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "units",
            "frame",
            "sign_convention"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "units": {
              "const": "Ha/Bohr^3"
            },
            "frame": {
              "const": "cartesian_tensor"
            },
            "sign_convention": {
              "const": "tensile_positive"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available"
            },
            "units": {
              "const": "Ha/Bohr^3"
            },
            "frame": {
              "const": "cartesian_tensor"
            },
            "sign_convention": {
              "const": "tensile_positive"
            },
            "quantity": {
              "enum": [
                "E",
                "F"
              ]
            },
            "values": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "symmetric": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "antisymmetric": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "antisymmetric_norm_ha_bohr3": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1e-10
            },
            "pressure_ha_bohr3": {
              "type": "number"
            },
            "basis_protocol": {
              "const": "frozen_miller_set"
            },
            "cutoff_ha": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cutoff_converged": {
              "const": false
            },
            "pulay_assessment": {
              "type": "object",
              "required": [
                "method",
                "isotropic_correction_ha_bohr3",
                "uncertainty_ha_bohr3",
                "warning"
              ],
              "properties": {
                "method": {
                  "const": "isotropic_cutoff_derivative_5_10_percent"
                },
                "isotropic_correction_ha_bohr3": {
                  "type": "number"
                },
                "uncertainty_ha_bohr3": {
                  "type": "number",
                  "minimum": 0
                },
                "warning": {
                  "type": "boolean"
                }
              }
            },
            "per_term": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "kinetic",
                "local",
                "nonlocal",
                "hartree",
                "xc",
                "core",
                "ewald",
                "entropy"
              ]
            },
            "derivative_ledger": {
              "type": "array",
              "minItems": 8
            },
            "unavailable_terms": {
              "type": "array",
              "maxItems": 0
            },
            "preconditions": {
              "type": "object",
              "required": [
                "convergence_profile",
                "converged",
                "fixed_point_certificate_passed"
              ],
              "properties": {
                "convergence_profile": {
                  "const": "strict"
                },
                "converged": {
                  "const": true
                },
                "fixed_point_certificate_passed": {
                  "const": true
                }
              }
            },
            "elapsed_seconds": {
              "type": "number",
              "minimum": 0
            },
            "band_passes": {
              "type": "integer",
              "minimum": 0
            },
            "precondition_force_band_passes": {
              "type": "integer",
              "minimum": 0
            },
            "cutoff_scf_runs": {
              "const": 3
            },
            "strain_steps": {
              "type": "array",
              "maxItems": 0
            }
          },
          "required": [
            "status",
            "units",
            "frame",
            "sign_convention",
            "quantity",
            "values",
            "symmetric",
            "antisymmetric",
            "antisymmetric_norm_ha_bohr3",
            "pressure_ha_bohr3",
            "basis_protocol",
            "cutoff_ha",
            "cutoff_converged",
            "pulay_assessment",
            "per_term",
            "derivative_ledger",
            "unavailable_terms",
            "preconditions",
            "elapsed_seconds",
            "band_passes",
            "precondition_force_band_passes",
            "cutoff_scf_runs",
            "strain_steps"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "spin": {
            "properties": {
              "mode": {
                "const": "unpolarized"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "occupations": {
            "properties": {
              "occupations_electrons": {
                "properties": {
                  "shape": {
                    "prefixItems": [
                      {
                        "const": 1
                      }
                    ],
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "spin": {
            "properties": {
              "mode": {
                "const": "collinear"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "occupations": {
            "properties": {
              "occupations_electrons": {
                "properties": {
                  "shape": {
                    "prefixItems": [
                      {
                        "const": 2
                      }
                    ],
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "occupations": {
            "properties": {
              "policy": {
                "const": "fixed_insulator"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "thermodynamics": {
            "properties": {
              "variational_quantity": {
                "const": "internal_energy"
              },
              "entropy_kind": {
                "const": "zero"
              },
              "entropy_term_ha": {
                "const": 0
              },
              "entropy_over_kb": {
                "const": 0
              },
              "temperature_energy_ha": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "occupations": {
            "properties": {
              "policy": {
                "const": "fixed_insulator"
              }
            }
          },
          "spin": {
            "properties": {
              "mode": {
                "const": "collinear"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spin": {
            "properties": {
              "constraint": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "electron_difference"
                ],
                "properties": {
                  "kind": {
                    "const": "fixed_total_moment"
                  },
                  "electron_difference": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "occupations": {
            "properties": {
              "policy": {
                "const": "fermi_dirac"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "thermodynamics": {
            "properties": {
              "variational_quantity": {
                "const": "free_energy"
              },
              "entropy_kind": {
                "const": "physical_fermi_dirac"
              },
              "temperature_energy_ha": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "occupations": {
            "properties": {
              "policy": {
                "const": "fermi_dirac"
              }
            }
          },
          "spin": {
            "properties": {
              "constraint": {
                "properties": {
                  "kind": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "occupations": {
            "properties": {
              "chemical_potential": {
                "properties": {
                  "kind": {
                    "const": "common"
                  }
                }
              },
              "moment_residual": {
                "type": "null"
              },
              "root_brackets_ha": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "occupations": {
            "properties": {
              "policy": {
                "const": "fermi_dirac"
              }
            }
          },
          "spin": {
            "properties": {
              "constraint": {
                "properties": {
                  "kind": {
                    "const": "fixed_total_moment"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "occupations": {
            "properties": {
              "chemical_potential": {
                "properties": {
                  "kind": {
                    "const": "per_spin"
                  }
                }
              },
              "moment_residual": {
                "type": "number"
              },
              "root_brackets_ha": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extension_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "forces": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "units",
              "frame"
            ],
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "not_implemented"
              },
              "units": {
                "const": "Ha/Bohr"
              },
              "frame": {
                "const": "cartesian_input_atom_order"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "forces": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "extension_version": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "forces": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "occupations": {
            "properties": {
              "policy": {
                "const": "fermi_dirac"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "forces": {
            "properties": {
              "quantity": {
                "const": "F"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "forces": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "occupations": {
            "properties": {
              "policy": {
                "const": "fixed_insulator"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "forces": {
            "properties": {
              "quantity": {
                "const": "E"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stress": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "extension_version": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stress": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "occupations": {
            "properties": {
              "policy": {
                "const": "fermi_dirac"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stress": {
            "properties": {
              "quantity": {
                "const": "F"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stress": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "occupations": {
            "properties": {
              "policy": {
                "const": "fixed_insulator"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stress": {
            "properties": {
              "quantity": {
                "const": "E"
              }
            }
          }
        }
      }
    }
  ]
}
