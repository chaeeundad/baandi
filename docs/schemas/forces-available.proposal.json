{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Available NC Cartesian forces",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "quantity",
    "units",
    "frame",
    "values",
    "per_term",
    "net_force",
    "maximum_absolute_component",
    "elapsed_seconds",
    "band_passes",
    "unavailable_terms",
    "derivative_ledger",
    "preconditions"
  ],
  "properties": {
    "status": {
      "const": "available"
    },
    "quantity": {
      "enum": [
        "E",
        "F"
      ]
    },
    "units": {
      "const": "Ha/Bohr"
    },
    "frame": {
      "const": "cartesian_input_atom_order"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "per_term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ewald",
        "local",
        "nonlocal",
        "core"
      ],
      "properties": {
        "ewald": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "local": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "nonlocal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "core": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "net_force": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "maximum_absolute_component": {
      "type": "number",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "band_passes": {
      "type": "integer",
      "minimum": 0
    },
    "unavailable_terms": {
      "type": "array",
      "maxItems": 0
    },
    "derivative_ledger": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "term_id",
          "owner",
          "active",
          "energy_ha",
          "included_in",
          "dependencies",
          "force_capability",
          "stress_capability",
          "reason"
        ],
        "properties": {
          "term_id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "energy_ha": {
            "type": [
              "number",
              "null"
            ]
          },
          "included_in": {
            "enum": [
              "E",
              "correction",
              "audit_only"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "force_capability": {
            "enum": [
              "available",
              "not_applicable"
            ]
          },
          "stress_capability": {
            "const": "unavailable"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "preconditions": {
      "$comment": "ADR 0043: a strict state with a passed certificate, or a standard state with a passed fixed-point verification",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "convergence_profile",
            "converged",
            "fixed_point_certificate_passed"
          ],
          "properties": {
            "convergence_profile": {
              "const": "strict"
            },
            "converged": {
              "type": "boolean",
              "const": true
            },
            "fixed_point_certificate_passed": {
              "type": "boolean",
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "convergence_profile",
            "converged",
            "fixed_point_verification_passed"
          ],
          "properties": {
            "convergence_profile": {
              "const": "standard"
            },
            "converged": {
              "type": "boolean",
              "const": true
            },
            "fixed_point_verification_passed": {
              "type": "boolean",
              "const": true
            }
          }
        }
      ]
    }
  }
}
