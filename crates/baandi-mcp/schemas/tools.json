  {
    "description": "Consume a host-validated input ID",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "calc_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "type": "string"
